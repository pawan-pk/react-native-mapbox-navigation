<resources>
    <!-- Night-mode maneuver banner text: white on the SDK's dark banner. -->
    <style name="PrimaryManeuverTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="ManeuverTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="StepDistanceRemainingAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">21sp</item>
    </style>

    <!-- Day-mode maneuver banner text: dark on a white banner, to mirror the
         iOS NavigationViewController banner. Picked by theme in the view. -->
    <style name="PrimaryManeuverTextAppearanceLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#0A0A0A</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">30sp</item>
    </style>
    <style name="ManeuverTextAppearanceLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#3A3A3A</item>
        <item name="android:textSize">25sp</item>
    </style>
    <style name="StepDistanceRemainingAppearanceLight" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#6B6B6B</item>
        <item name="android:textSize">21sp</item>
    </style>

    <!-- Day-mode turn-arrow icon: dark so it stays visible on the white banner
         (the SDK default is light, tuned for the dark banner). -->
    <style name="TurnIconManeuverLight" parent="MapboxStyleTurnIconManeuver">
        <item name="maneuverTurnIconColor">#0A0A0A</item>
    </style>

    <!-- Branded banner turn-arrow / lane icon: white on the brand background
         (topBannerBackgroundColor prop set). -->
    <style name="TurnIconManeuverBrand" parent="MapboxStyleTurnIconManeuver">
        <item name="maneuverTurnIconColor">#FFFFFF</item>
    </style>
</resources>
